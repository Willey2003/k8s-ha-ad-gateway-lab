<mxfile host="app.diagrams.net"><diagram name="Home Lab Infrastructure" id="lab"><mxGraphModel dx="1680" dy="1180" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="z_user" value="User network  10.10.5.0/24" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=3;fillColor=#eef3ff;strokeColor=#5b7bd5;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#5b7bd5;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="520" height="200" as="geometry"/></mxCell><mxCell id="z_ad" value="Active Directory  corp.example" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=3;fillColor=#fff4e0;strokeColor=#c98a1a;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#c98a1a;container=0;" vertex="1" parent="1"><mxGeometry x="1140" y="20" width="520" height="200" as="geometry"/></mxCell><mxCell id="z_lab" value="Lab network  10.10.1.0/24  (vSphere lab VLAN port group)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=3;fillColor=#f4f7f9;strokeColor=#7f95a6;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#7f95a6;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="1640" height="830" as="geometry"/></mxCell><mxCell id="z_cp" value="Kubernetes control plane  v1.32.13 / cri-o 1.32.1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=3;fillColor=#e3f1f2;strokeColor=#0d6b76;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#0d6b76;container=0;" vertex="1" parent="1"><mxGeometry x="470" y="450" width="740" height="250" as="geometry"/></mxCell><mxCell id="z_wk" value="Worker nodes  (application pods, Calico BGP)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=3;fillColor=#eef6ec;strokeColor=#3f8a4a;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#3f8a4a;container=0;" vertex="1" parent="1"><mxGeometry x="470" y="740" width="740" height="400" as="geometry"/></mxCell><mxCell id="z_etcd" value="External etcd cluster  v3.5.27  (TLS)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=3;fillColor=#fbeaea;strokeColor=#b04848;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#b04848;container=0;" vertex="1" parent="1"><mxGeometry x="1250" y="450" width="390" height="330" as="geometry"/></mxCell><mxCell id="users" value="&lt;b&gt;Lab users &amp;amp; admins&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#586674'&gt;Windows PCs, e.g. 10.10.5.7&lt;br&gt;SSH client + browser&lt;br&gt;AD login&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#5b7bd5;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=13;fontColor=#18222d;" vertex="1" parent="1"><mxGeometry x="50" y="70" width="220" height="120" as="geometry"/></mxCell><mxCell id="browser" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#586674'&gt;https://&amp;lt;app&amp;gt;.apps.corp.example&lt;br&gt;trusts Home Lab Root CA&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#5b7bd5;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=13;fontColor=#18222d;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="210" height="120" as="geometry"/></mxCell><mxCell id="dc1" value="&lt;b&gt;dc01&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#586674'&gt;10.10.5.251&lt;br&gt;AD · DNS · NTP · Kerberos&lt;br&g
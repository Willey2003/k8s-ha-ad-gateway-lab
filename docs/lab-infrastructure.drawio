ft=8;spacingTop=4;fontSize=13;fontColor=#18222d;" vertex="1" parent="1"><mxGeometry x="50" y="390" width="380" height="300" as="geometry"/></mxCell><mxCell id="vip" value="&lt;b&gt;API VIP  10.10.1.20:6443&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;k8s-api.corp.example  (kube-vip, ARP)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#0d6b76;strokeColor=#0d6b76;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="690" y="480" width="300" height="52" as="geometry"/></mxCell><mxCell id="m0" value="&lt;b&gt;manager&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#586674'&gt;10.10.1.14&lt;br&gt;apiserver · scheduler&lt;br&gt;controller-mgr · kube-vip&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#0d6b76;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=13;fontColor=#18222d;" vertex="1" parent="1"><mxGeometry x="495" y="570" width="210" height="110" as="geometry"/></mxCell><mxCell id="m1" value="&lt;b&gt;manager-2&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#586674'&gt;10.10.1.21&lt;br&gt;apiserver · scheduler&lt;br&gt;controller-mgr · kube-vip&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#0d6b76;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=13;fontColor=#18222d;" vertex="1" parent="1"><mxGeometry x="735" y="570" width="210" height="110" as="geometry"/></mxCell><mxCell id="m2" value="&lt;b&gt;manager-3&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#586674'&gt;10.10.1.22&lt;br&gt;apiserver · scheduler&lt;br&gt;controller-mgr · kube-vip&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#0d6b76;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=13;fontColor=#18222d;" vertex="1" parent="1"><mxGeometry x="975" y="570" width="210" height="110" as="geometry"/></mxCell><mxCell id="w0" value="&lt;b&gt;worker-a&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#586674'&gt;10.10.1.15&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#3f8a4a;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=13;fontColor=#18222d;" vertex="1" parent="1"><mxGeometry x="490" y="790" width="160" height="72" as="geometry"/></mxCell><mxCell id="w1" value="&lt;b&gt;worker-b&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#586674'&gt;10.10.1.16&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#3f8a4a;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=13;fontColor=#18222d;" vertex="1" parent="1"><mxGeometry x="670" y="790" width="160" height="72" as="geometry"/></mxCell><mxCell id="w2" value="&lt;b&gt;worker-c&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#586674'&gt;10.10.1.17&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#3f8a4a;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=13;fontColor=#18222d;" vertex="1" parent="1"><mxGeometry x="850" y="790" width="160" height="72" as="geometry"/></mxCell><mxCell id="w3" value="&lt;b&gt;worker-d&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#586674'&gt;10.10.1.18&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#3f8a4a;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=13;fontColor=#18222d;" vertex="1" parent="1"><mxGeometry x="1030" y="790" width="160" height="72" as="geometry"/></mxCell><mxCell id="pods" value="&lt;b&gt;Platform services running on the workers&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#586674'&gt;• Dex ×2  –  AD login (OIDC), NodePort 32000 → dex.corp.example via VIP&lt;br&gt;• HAProxy Unified Gateway ×2  –  Gateway &amp;quot;apps&amp;quot; :80/:443, wildcard TLS *.apps&lt;br&gt;• MetalLB  –  L2 speakers, pool 10.10.1.25-29 (+.40-.49 after /24)&lt;br&gt;• Velero server + node-agent  –  backups to Bastion S3&lt;br&gt;• CoreDNS (corp.example → DCs) · Calico · kube-proxy&lt;br&gt;• playground namespace  –  user apps (quota, Pod Security baseline)&lt;br&gt;   e.g. hello.apps.corp.example&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#3f8a4a;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#18222d;" vertex="1" parent="1"><mxGeometry x="490" y="885" width="700" height="240" as="geometry"/></mxCell><mxCell id="lbip" value="&lt;b&gt;App gateway  10.10.1.25&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#586674'&gt;*.apps.corp.example  ports 80 / 443&lt;br&gt;MetalLB LoadBalancer IP (announced by a worker)&lt;br&gt;→ HAProxy Unified Gateway pods&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#1f78b4;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=13;fontColor=#18222d;" vertex="1" parent="1"><mxGeometry x="50" y="760" width="380" height="110" as="geometry"/></mxCell><mxCell id="rbac" value="&lt;b&gt;Access model (AD groups → RBAC)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#586674'&gt;Lab user (all Domain Users)&lt;br&gt;  SSH: Bastion only, no sudo&lt;br&gt;  K8s: view cluster (no Secrets)&lt;br&gt;        + edit in namespace playground&lt;br&gt;&lt;br&gt;Lab administrator (K8s-Admins)&lt;br&gt;  SSH + sudo on all 11 machines&lt;br&gt;  K8s: cluster-admin&lt;br&gt;&lt;br&gt;Emergency: local accounts + admin.conf&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#586674;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#18222d;" vertex="1" parent="1"><mxGeometry x="50" y="900" width="380" height="240" as="geometry"/></mxCell><mxCell id="e0" value="&lt;b&gt;etcd-1  10.10.1.12&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#586674'&gt;:2379 client / :2380 peer&lt;br&gt;also: v1.29 worker (other cluster)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#b04848;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=13;fontColor=#18222d;" vertex="1" parent="1"><mxGeometry x="1275" y="495" width="340" height="78" as="geometry"/></mxCell><mxCell id="e1" value="&lt;b&gt;etcd-2  10.10.1.13&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#586674'&gt;:2379 client / :2380 peer&lt;br&gt;also: v1.29 worker (other cluster)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#b04848;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=13;fontColor=#18222d;" vertex="1" parent="1"><mxGeometry x="1275" y="587" width="340" height="78" as="geometry"/></mxCell><mxCell id="e2" value="&lt;b&gt;etcd-3  10.10.1.19&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#586674'&gt;:2379 client / :2380 peer&lt;br&gt;also: k3s server + NFS server&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#b04848;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=13;fontColor=#18222d;" vertex="1" parent="1"><mxGeometry x="1275" y="679" width="340" height="78" as="geometry"/></mxCell><mxCell id="note_etcd" value="&lt;b&gt;Shared etcd VMs&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#586674'&gt;The etcd VMs also host other lab clusters.&lt;br&gt;Next project: dedicated etcd VMs.&lt;/span&gt;" style="html=1;whiteSpace=wrap;font